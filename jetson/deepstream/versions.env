# JetPack 버전별 짝. 로봇에서 `cat /etc/nv_tegra_release` 로 L4T 버전을 보고 고른다.
#   R36.3.x → JetPack 6.0   R36.4.0 → JetPack 6.1   R36.4.3+ → JetPack 6.2
# 2026-11-08 AWS 에서 세 벌 모두 빌드 확인됨 (태그·pyds 버전 유효). 바꿀 때는 NGC 태그 확인:
#   https://catalog.ngc.nvidia.com/orgs/nvidia/containers/deepstream-l4t/tags
#   pyds: https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases

# JetPack 6.0 — DeepStream 7.0
JP60_DS_IMAGE=nvcr.io/nvidia/deepstream-l4t:7.0-samples-multiarch
JP60_CUDA_VER=12.2
JP60_PYDS_VER=1.1.11
JP60_PYDS_WHEEL=https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.1.11/pyds-1.1.11-py3-none-linux_aarch64.whl

# JetPack 6.1 — DeepStream 7.1
JP61_DS_IMAGE=nvcr.io/nvidia/deepstream-l4t:7.1-samples-multiarch
JP61_CUDA_VER=12.6
JP61_PYDS_VER=1.2.0
JP61_PYDS_WHEEL=https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-cp310-cp310-linux_aarch64.whl

# JetPack 6.2 — DeepStream 7.1 (6.2 에서도 동작) 또는 8.0. [확인 필요] 8.0 태그가 있으면 바꿔도 됨
JP62_DS_IMAGE=nvcr.io/nvidia/deepstream-l4t:7.1-samples-multiarch
JP62_CUDA_VER=12.6
JP62_PYDS_VER=1.2.0
JP62_PYDS_WHEEL=https://github.com/NVIDIA-AI-IOT/deepstream_python_apps/releases/download/v1.2.0/pyds-1.2.0-cp310-cp310-linux_aarch64.whl
